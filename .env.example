# Copier vers .env : cp .env.example .env
NODE_ENV=development

# --- Base de données -------------------------------------------------------
DATABASE_URL="postgresql://visiora:visiora@localhost:5432/visiora_agile?schema=public"

# --- API -------------------------------------------------------------------
API_PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# --- Authentification ------------------------------------------------------
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=changeme-access-secret-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=changeme-refresh-secret-in-production
JWT_REFRESH_TTL=7d

# --- Stockage objet (pièces jointes) ---------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=visiora-attachments
S3_ACCESS_KEY=visiora
S3_SECRET_KEY=visiora123
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=25

# --- Email (Mailhog en local) ----------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="VisioraAI Agile <no-reply@visiora.ai>"

# --- File d'attente --------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Frontend --------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=http://localhost:3000
