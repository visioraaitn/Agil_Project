# Copier vers .env : cp .env.example .env
NODE_ENV=development

# --- Base de données -------------------------------------------------------
# Utiliser le Session Pooler (port 5432) pour Prisma Migrate/GitHub Actions.
# Encoder les caractères spéciaux du mot de passe, par ex. + -> %2B.
DATABASE_URL="postgresql://postgres.<project-ref>:YOUR_DATABASE_PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# --- API -------------------------------------------------------------------
API_PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- Authentification ------------------------------------------------------
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_REFRESH_TTL=7d
# `none` uniquement si frontend et API utilisent des domaines différents (Netlify/Render)
AUTH_COOKIE_SAME_SITE=lax

# --- Seed admin -----------------------------------------------------------
ADMIN_SEED_EMAIL=admin@your-domain.com
ADMIN_SEED_PASSWORD=replace-with-a-strong-admin-password
# Optionnel, uniquement pour la commande manuelle `pnpm db:seed:demo` (interdite en production)
DEMO_SEED_PASSWORD=replace-with-a-strong-demo-password

# --- Stockage objet (pièces jointes) ---------------------------------------
# Générer ces clés dans Supabase > Storage > Settings > S3 (serveur uniquement).
# Endpoint direct recommandé : https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=<project-region>
S3_BUCKET=attachments
S3_ACCESS_KEY=replace-with-supabase-s3-access-key
S3_SECRET_KEY=replace-with-supabase-s3-secret-key
MAX_UPLOAD_MB=25

# --- Email (Mailhog en local) ----------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="VisioraAI Agile <no-reply@visiora.ai>"

# --- File d'attente --------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Frontend --------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=http://localhost:3000
VITE_API_DOCS_URL=http://localhost:3000/api/v1/docs
