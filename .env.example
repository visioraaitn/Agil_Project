# Configuration locale uniquement.
# Copier ce fichier vers `.env`, puis lancer `pnpm infra:up`.
# Ne jamais réutiliser ces identifiants de développement en production.
NODE_ENV=development

# --- Base de données PostgreSQL Docker -------------------------------------
# Service `postgres` de docker-compose.yml, exposé sur la machine locale.
DATABASE_URL="postgresql://visiora:visiora@localhost:5432/visiora_agile?schema=public"

# --- API -------------------------------------------------------------------
API_PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- Authentification locale -----------------------------------------------
# Valeurs non sensibles réservées au développement local.
JWT_ACCESS_SECRET=local-development-access-secret-change-me-2026
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=local-development-refresh-secret-change-me-2026
JWT_REFRESH_TTL=7d
AUTH_COOKIE_SAME_SITE=lax

# --- Seeds locaux ----------------------------------------------------------
# Utilisés seulement par les commandes manuelles `pnpm db:seed` et
# `pnpm db:seed:demo`. Les seeds ne sont jamais exécutés au déploiement.
ADMIN_SEED_EMAIL=admin@visiora.local
ADMIN_SEED_PASSWORD=AdminLocal123!
DEMO_SEED_PASSWORD=DemoLocal123!

# --- Stockage objet MinIO Docker -------------------------------------------
# Console : http://localhost:9001 (visiora / visiora123).
# Créer une fois le bucket privé `attachments` dans la console MinIO.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=attachments
S3_ACCESS_KEY=visiora
S3_SECRET_KEY=visiora123
MAX_UPLOAD_MB=25

# --- Email Mailhog Docker --------------------------------------------------
# Les emails sont capturés localement dans http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="VisioraAI Agile <no-reply@visiora.local>"

# --- Redis Docker ----------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Frontend local --------------------------------------------------------
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=http://localhost:3000
VITE_API_DOCS_URL=http://localhost:3000/api/v1/docs
